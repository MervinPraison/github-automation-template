name: {{CLAUDE_WORKFLOW_NAME}}

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]
  issues:
    types: [assigned, labeled, opened]
  pull_request_review:
    types: [submitted]

jobs:
  claude:
    uses: MervinPraison/github-automation-template/.github/workflows/claude-assistant-callable.yml@{{HUB_REF}}
    secrets: inherit
    with:
      hub_ref: {{HUB_REF}}
